{
  "appId": "io.github.penspanic.parawatch",
  "productName": "Parawatch",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**",
    "package.json",
    "!**/node_modules/**"
  ],
  "asar": true,
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      "dmg",
      "zip"
    ],
    "icon": "icon/Parawatch.icon",
    "identity": "-"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.png"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "build/icon.png",
    "category": "Development"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "enableCookieEncryption": true
  },
  "dmg": {
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "penspanic",
      "repo": "parawatch",
      "releaseType": "release"
    }
  ]
}
