{
  "name": "parawatch",
  "version": "0.3.7",
  "description": "A control tower for people running many AI coding agents in parallel: see what is running, what needs you, and wake the right agent when you answer.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "cli",
    "human-in-the-loop",
    "parallel",
    "inbox"
  ],
  "license": "MIT",
  "author": "penspanic",
  "homepage": "https://github.com/penspanic/parawatch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penspanic/parawatch.git"
  },
  "bugs": {
    "url": "https://github.com/penspanic/parawatch/issues"
  },
  "type": "module",
  "bin": {
    "parawatch": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bin/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && npm run typecheck -w @parawatch/panel -w @parawatch/desktop",
    "prepublishOnly": "npm run build && npm test",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
